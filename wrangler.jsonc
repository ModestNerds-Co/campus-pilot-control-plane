{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campus-pilot-control-plane",
  "main": "./build/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "build": {
    "command": "worker-build --release --no-panic-recovery"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-pilot-control-plane",
      "database_id": "eae1779b-edef-4aa0-a318-1050066358ba",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["licensing@antonlabs.cc"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_APP_URL": "https://campus-pilot-control-plane.imngonii.workers.dev",
    "CUSTOMER_APP_URL": "https://campus-pilot-control-plane.imngonii.workers.dev",
    "OWNER_APP_URL": "https://campus-pilot-control-plane.imngonii.workers.dev",
    "AUTH_FROM_EMAIL": "licensing@antonlabs.cc",
    "LICENSE_ISSUER": "campus-pilot-control-plane",
    "LICENSE_AUDIENCE": "campus-pilot",
    "LICENSE_SIGNING_KEY_ID": "production-1",
    "LEASE_ACTIVE_DAYS": "30",
    "LEASE_GRACE_DAYS": "7",
    "MAGIC_LINK_MINUTES": "15",
    "SESSION_DAYS": "7"
  },
  "secrets": {
    "required": [
      "LICENSE_SIGNING_PRIVATE_KEY",
      "LICENSE_SIGNING_PUBLIC_KEY",
      "SESSION_PEPPER",
      "OWNER_EMAILS",
      "REROUT_API_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
